cmd_status() {
    local vm=""
    while (($#)); do
        case "$1" in
            --project) [[ $# -ge 2 ]] || die "--projectに値が必要です"; PROJECT=$2; shift 2 ;;
            -h|--help) usage; return 0 ;;
            -*) die "statusの不明なオプションです: $1" ;;
            *) [[ -z "$vm" ]] || die "VM指定が多すぎます"; vm=$1; shift ;;
        esac
    done
    [[ -n "$vm" ]] || die "VM名を指定してください。"

    load_instances
    load_vm "$vm"
    check_cluster_location "$vm"

    printf 'VM: %s\nType: %s\nStatus: %s\nLocation: %s\n' "$vm" "$VM_TYPE" "$VM_STATUS" "${VM_LOCATION:--}"
    printf 'GPU devices:\n'
    local lines line name bdf type origin count=0
    lines=$(instance_gpu_devices "$vm" expanded || true)
    while IFS=$'\t' read -r name bdf type origin; do
        [[ -n "$name" ]] || continue
        ((count += 1))
        printf '  - %-20s pci=%-12s gputype=%-10s origin=%s' "$name" "${bdf:-auto}" "$type" "$origin"
        if [[ -n "$bdf" ]]; then
            local normalized
            normalized=$(normalize_bdf "$bdf" 2>/dev/null || printf '%s' "$bdf")
            if [[ -d "$(pci_path "$normalized")" ]]; then
                printf ' host-driver=%s iommu=%s' "$(pci_driver "$normalized")" "$(pci_iommu_group "$normalized")"
            else
                printf ' host-device=not-on-this-node'
            fi
        fi
        printf '\n'
    done <<<"$lines"
    ((count > 0)) || printf '  (none)\n'
}

cmd_attach() {
    local vm="" selector="" requested_device="" bdf device existing_line=""
    local prebind_requested=0 vfio_timeout=$VFIO_BIND_TIMEOUT
    local -a positional=()

    while (($#)); do
        case "$1" in
            --vm) [[ $# -ge 2 ]] || die "--vmに値が必要です"; vm=$2; shift 2 ;;
            --gpu) [[ $# -ge 2 ]] || die "--gpuに値が必要です"; selector=$2; shift 2 ;;
            --device|--device-name) [[ $# -ge 2 ]] || die "$1に値が必要です"; requested_device=$2; shift 2 ;;
            --project) [[ $# -ge 2 ]] || die "--projectに値が必要です"; PROJECT=$2; shift 2 ;;
            --stop) STOP_MODE="stop"; shift ;;
            --restart) STOP_MODE="restart"; shift ;;
            --start) START_REQUESTED=1; shift ;;
            --force-stop) FORCE_STOP=1; shift ;;
            --force) FORCE=1; shift ;;
            --timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--timeoutには秒数が必要です"; STOP_TIMEOUT=$2; shift 2 ;;
            --prebind-vfio) prebind_requested=1; shift ;;
            --vfio-timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--vfio-timeoutには秒数が必要です"; vfio_timeout=$2; shift 2 ;;
            --keep-on-failure) KEEP_ON_START_FAILURE=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            -h|--help) usage; return 0 ;;
            -*) die "attachの不明なオプションです: $1" ;;
            *) positional+=("$1"); shift ;;
        esac
    done

    [[ -n "$vm" ]] || vm=${positional[0]:-}
    [[ -n "$selector" ]] || selector=${positional[1]:-}
    ((${#positional[@]} <= 2)) || die "attachの位置引数が多すぎます。"
    [[ -n "$vm" && -n "$selector" ]] || die "attachにはVM名とGPU指定が必要です。"

    bdf=$(resolve_gpu "$selector")

    load_instances
    load_vm "$vm"
    check_cluster_location "$vm"

    existing_line=$(check_other_assignments "$vm" "$bdf")
    if [[ -n "$existing_line" ]]; then
        local existing_vm existing_device existing_status
        IFS=$'\t' read -r existing_vm existing_device existing_status <<<"$existing_line"
        ok "GPU $bdf はVM '$vm' に既に設定済みです (device=$existing_device)。変更はありません。"
        return 0
    fi

    preflight_gpu "$bdf"
    device=$(choose_device_name "$vm" "$bdf" "$requested_device")
    stop_vm_for_change "$vm"

    if (( prebind_requested )); then
        local prebind_rc=0
        info "Incus起動前にGPU関連PCI機能をvfio-pciへ事前バインドします。"
        if prebind_vfio_functions "$bdf" "$vfio_timeout"; then
            :
        else
            prebind_rc=$?
            if [[ -n "$SYSFS_WRITE_STUCK_PID" ]]; then
                warn "PCI probeがカーネル内で継続中のため、VM '$vm' は停止したままにします。"
                warn "別端末で次を確認してください: ps -o pid,ppid,stat,wchan:32,cmd -p $SYSFS_WRITE_STUCK_PID"
                warn "state=Dのままなら、ホスト再起動後にVMを起動してください。"
                die "VFIO bind/probeが監視時間を超過しました（worker PID=$SYSFS_WRITE_STUCK_PID）。"
            fi
            if (( VM_ORIGINALLY_RUNNING && ! DRY_RUN )); then
                warn "事前バインド失敗のため、元の構成でVM '$vm' を再起動します。"
                incus_read start "$vm" || warn "元の構成でもVMを再起動できませんでした。"
            fi
            die "VFIO事前バインドに失敗しました (exit=$prebind_rc)。Incusデバイスは追加しません。"
        fi
    fi

    info "Incusデバイス '$device' としてGPU $bdf をVM '$vm' に追加します。"
    if ! incus_mutate config device add "$vm" "$device" gpu gputype=physical "pci=$bdf"; then
        (( prebind_requested )) && restore_prebound_vfio || true
        if (( VM_ORIGINALLY_RUNNING && ! DRY_RUN )); then
            warn "デバイス追加失敗のため、元の構成でVM '$vm' を再起動します。"
            incus_read start "$vm" || warn "元の構成でもVMを再起動できませんでした。"
        fi
        die "Incus GPUデバイスを追加できませんでした。"
    fi

    if (( VM_SHOULD_START || START_REQUESTED )); then
        local start_epoch
        start_epoch=$(date +%s)
        if ! start_vm_after_change "$vm"; then
            diagnose_start_failure "$bdf" "$start_epoch"
            if (( ! DRY_RUN && ! KEEP_ON_START_FAILURE )); then
                warn "GPU追加後のVM起動に失敗しました。追加したデバイスをロールバックします。"
                if incus_read config device remove "$vm" "$device"; then
                    if (( prebind_requested )); then
                        restore_prebound_vfio || warn "事前バインドしたPCI機能を完全には復元できませんでした。"
                    fi
                else
                    warn "ロールバックにも失敗しました。手動確認してください。"
                fi
                if (( VM_ORIGINALLY_RUNNING )); then
                    warn "元の構成でVMを再起動します。"
                    incus_read start "$vm" || warn "元の構成でもVMを起動できませんでした。"
                fi
            fi
            local info_cmd
            info_cmd=$(print_project_log_command "$vm")
            die "VM起動に失敗しました。'${PROG} doctor --vm $vm --gpu $bdf${PROJECT:+ --project $PROJECT} --kernel-log' と '$info_cmd' を確認してください。"
        fi
    fi

    ok "GPUを設定しました: VM=$vm device=$device pci=$bdf"
}

cmd_detach() {
    local vm="" selector="" requested_device="" bdf="" lines line name pci type origin
    local -a positional=() candidates=()

    while (($#)); do
        case "$1" in
            --vm) [[ $# -ge 2 ]] || die "--vmに値が必要です"; vm=$2; shift 2 ;;
            --gpu) [[ $# -ge 2 ]] || die "--gpuに値が必要です"; selector=$2; shift 2 ;;
            --device|--device-name) [[ $# -ge 2 ]] || die "$1に値が必要です"; requested_device=$2; shift 2 ;;
            --project) [[ $# -ge 2 ]] || die "--projectに値が必要です"; PROJECT=$2; shift 2 ;;
            --stop) STOP_MODE="stop"; shift ;;
            --restart) STOP_MODE="restart"; shift ;;
            --start) START_REQUESTED=1; shift ;;
            --force-stop) FORCE_STOP=1; shift ;;
            --force) FORCE=1; shift ;;
            --timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--timeoutには秒数が必要です"; STOP_TIMEOUT=$2; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            -h|--help) usage; return 0 ;;
            -*) die "detachの不明なオプションです: $1" ;;
            *) positional+=("$1"); shift ;;
        esac
    done

    [[ -n "$vm" ]] || vm=${positional[0]:-}
    [[ -n "$selector" ]] || selector=${positional[1]:-}
    ((${#positional[@]} <= 2)) || die "detachの位置引数が多すぎます。"
    [[ -n "$vm" ]] || die "detachにはVM名が必要です。"

    load_instances
    load_vm "$vm"
    check_cluster_location "$vm"
    lines=$(instance_gpu_devices "$vm" direct || true)

    if [[ -n "$requested_device" ]]; then
        while IFS=$'\t' read -r name pci type origin; do
            [[ "$name" == "$requested_device" ]] && candidates+=("$name"$'\t'"$pci")
        done <<<"$lines"
    elif [[ -n "$selector" ]]; then
        bdf=$(resolve_gpu "$selector")
        while IFS=$'\t' read -r name pci type origin; do
            local normalized=""
            normalized=$(normalize_bdf "$pci" 2>/dev/null || true)
            [[ "$normalized" == "$bdf" ]] && candidates+=("$name"$'\t'"$pci")
        done <<<"$lines"
    else
        while IFS=$'\t' read -r name pci type origin; do
            [[ -n "$name" ]] && candidates+=("$name"$'\t'"$pci")
        done <<<"$lines"
    fi

    if ((${#candidates[@]} == 0)); then
        die "削除対象のローカルGPUデバイスが見つかりません。プロファイル由来のデバイスはstatusで確認してください。"
    elif ((${#candidates[@]} > 1)); then
        warn "GPUデバイスが複数あります:"
        printf '  %b\n' "${candidates[@]}" >&2
        die "--device NAME またはGPU指定で対象を絞ってください。"
    fi

    IFS=$'\t' read -r requested_device bdf <<<"${candidates[0]}"
    stop_vm_for_change "$vm"

    info "VM '$vm' からIncusデバイス '$requested_device' (pci=$bdf) を削除します。"
    incus_mutate config device remove "$vm" "$requested_device"
    start_vm_after_change "$vm"
    ok "GPU設定を削除しました: VM=$vm device=$requested_device"
}

confirm_or_die() {
    local prompt=$1 reply
    (( YES || DRY_RUN )) && return 0
    [[ -r /dev/tty ]] || die "確認入力できません。内容を確認して --yes を付けてください。"
    printf '%s [y/N]: ' "$prompt" >/dev/tty
    IFS= read -r reply </dev/tty || true
    [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]] || die "中止しました。"
}

write_managed_file() {
    local path=$1 content=$2
    if (( DRY_RUN )); then
        printf '+ write %q\n%s\n' "$path" "$content" >&2
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    if [[ -e "$path" ]] && ! grep -q '^# Managed by incus-gpu$' "$path"; then
        cp -a "$path" "${path}.bak.$(date +%Y%m%d%H%M%S)"
        warn "既存ファイルをバックアップしました: ${path}.bak.*"
    fi
    printf '%s\n' "$content" > "$path"
    chmod 0644 "$path"
}

cmd_prepare_host() {
    local undo=0 cpu_vendor iommu_flag grub_file modules_file cmdline
    while (($#)); do
        case "$1" in
            --yes|-y) YES=1; shift ;;
            --undo) undo=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            -h|--help) usage; return 0 ;;
            *) die "prepare-hostの不明なオプションです: $1" ;;
        esac
    done

    if (( ! DRY_RUN && EUID != 0 )); then
        die "prepare-hostはroot権限が必要です。sudoで実行してください。"
    fi

    grub_file="$ETC_ROOT/default/grub.d/99-incus-gpu-passthrough.cfg"
    modules_file="$ETC_ROOT/modules-load.d/incus-gpu-vfio.conf"

    if (( undo )); then
        info "incus-gpuが管理するIOMMU/VFIO起動設定を削除します。"
        confirm_or_die "削除してinitramfs/GRUBを更新しますか?"
        if (( DRY_RUN )); then
            print_command rm -f "$grub_file" "$modules_file"
        else
            if [[ -e "$grub_file" ]] && grep -q '^# Managed by incus-gpu$' "$grub_file"; then rm -f "$grub_file"; fi
            if [[ -e "$modules_file" ]] && grep -q '^# Managed by incus-gpu$' "$modules_file"; then rm -f "$modules_file"; fi
        fi
        command -v update-initramfs >/dev/null 2>&1 && host_mutate update-initramfs -u
        command -v update-grub >/dev/null 2>&1 && host_mutate update-grub
        ok "管理設定を削除しました。反映には再起動が必要です。"
        return 0
    fi

    cpu_vendor=$(awk -F: '/^[[:space:]]*vendor_id[[:space:]]*:/{gsub(/[[:space:]]/, "", $2); print $2; exit}' "$PROC_ROOT/cpuinfo" 2>/dev/null || true)
    case "$cpu_vendor" in
        GenuineIntel) iommu_flag="intel_iommu=on" ;;
        AuthenticAMD) iommu_flag="amd_iommu=on" ;;
        *) die "CPUベンダーを判定できません。現在はx86_64 Intel/AMDのGRUB構成のみ自動設定します (vendor='$cpu_vendor')。" ;;
    esac

    command -v update-grub >/dev/null 2>&1 || (( DRY_RUN )) || die "update-grubがありません。UbuntuのGRUB環境で実行してください。"
    command -v update-initramfs >/dev/null 2>&1 || (( DRY_RUN )) || die "update-initramfsがありません。"

    cmdline=$(cat "$PROC_ROOT/cmdline" 2>/dev/null || true)
    info "設定するカーネル引数: $iommu_flag iommu=pt"
    if [[ "$cmdline" == *"$iommu_flag"* ]]; then
        info "$iommu_flag は現在のカーネルでも有効です。永続設定とVFIOモジュール設定を確認・更新します。"
    fi
    warn "この処理はGRUBとinitramfsを更新します。BIOS/UEFI側のVT-d/AMD-Viは別途有効化が必要です。"
    confirm_or_die "IOMMU/VFIO起動設定を適用しますか?"

    write_managed_file "$grub_file" "# Managed by incus-gpu
# Enables host IOMMU. Incus performs per-device vfio-pci rebinding when a VM starts.
GRUB_CMDLINE_LINUX_DEFAULT=\"\${GRUB_CMDLINE_LINUX_DEFAULT} $iommu_flag iommu=pt\""
    write_managed_file "$modules_file" "# Managed by incus-gpu
vfio
vfio_pci
vfio_iommu_type1"

    host_mutate update-initramfs -u
    host_mutate update-grub
    if command -v modprobe >/dev/null 2>&1; then
        host_mutate modprobe vfio-pci || warn "vfio-pciを即時ロードできませんでした。再起動後に確認してください。"
    fi

    ok "ホスト起動設定を更新しました。再起動後に '${PROG} doctor' を実行してください。"
}

cmd_doctor() {
    local vm="" selector="" failures=0 version="" bdf="" group="" modules="" show_kernel_log=0
    while (($#)); do
        case "$1" in
            --vm) [[ $# -ge 2 ]] || die "--vmに値が必要です"; vm=$2; shift 2 ;;
            --gpu) [[ $# -ge 2 ]] || die "--gpuに値が必要です"; selector=$2; shift 2 ;;
            --project) [[ $# -ge 2 ]] || die "--projectに値が必要です"; PROJECT=$2; shift 2 ;;
            --kernel-log) show_kernel_log=1; shift ;;
            -h|--help) usage; return 0 ;;
            *) die "doctorの不明なオプションです: $1" ;;
        esac
    done

    printf 'incus-gpu doctor %s\n\n' "$VERSION"
    printf '[INFO] Host kernel: %s\n' "$(uname -r 2>/dev/null || printf unknown)"

    if command -v "$INCUS_BIN" >/dev/null 2>&1; then
        if version=$(incus_read version 2>/dev/null); then
            version=$(printf '%s\n' "$version" | head -n 2 | tr '\n' ' ')
            printf '[OK] Incus CLI/server: %s\n' "${version:-応答あり}"
        else
            printf '[NG] Incus CLIはありますがローカルサーバーへ接続できません\n'
            ((failures += 1))
        fi
    else
        printf '[NG] Incus CLIがありません: %s\n' "$INCUS_BIN"
        ((failures += 1))
    fi

    if command -v "$PYTHON_BIN" >/dev/null 2>&1; then
        printf '[OK] Python JSON parser: %s\n' "$PYTHON_BIN"
    else
        printf '[NG] Python 3がありません: %s\n' "$PYTHON_BIN"
        ((failures += 1))
    fi

    if [[ -e "$DEV_ROOT/kvm" ]]; then
        printf '[OK] KVM device: %s/kvm\n' "$DEV_ROOT"
    else
        printf '[NG] /dev/kvm相当がありません: %s/kvm\n' "$DEV_ROOT"
        ((failures += 1))
    fi

    if [[ -d "$SYSFS_ROOT/kernel/iommu_groups" ]] && find "$SYSFS_ROOT/kernel/iommu_groups" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null | grep -q .; then
        printf '[OK] Host IOMMU groups are present\n'
    else
        printf '[NG] Host IOMMU groups are absent\n'
        ((failures += 1))
    fi

    modules=$(awk '{print $1}' "$PROC_ROOT/modules" 2>/dev/null | grep -E '^vfio(_pci|_iommu_type1)?$' | sort | tr '\n' ' ' || true)
    if [[ "$modules" == *"vfio_pci"* || -d "$SYSFS_ROOT/module/vfio_pci" ]]; then
        printf '[OK] VFIO modules: %s\n' "${modules:-vfio_pci}"
    else
        printf '[WARN] vfio_pciは現在未ロードです（VM起動時にロード可能なら問題ありません）\n'
    fi

    printf '\nGPU inventory:\n'
    list_gpus || ((failures += 1))

    if [[ -n "$selector" ]]; then
        bdf=$(resolve_gpu "$selector")
        group=$(pci_iommu_group "$bdf")
        printf '\nSelected GPU: %s / %s\n' "$bdf" "$(pci_description "$bdf")"
        printf '  driver=%s override=%s iommu_group=%s boot_vga=%s\n' \
            "$(pci_driver "$bdf")" "$(pci_driver_override "$bdf")" "$group" "$(pci_boot_vga "$bdf")"
        [[ "$group" != "-" ]] || ((failures += 1))
        print_vfio_state "$bdf"
        if (( show_kernel_log )); then
            print_kernel_vfio_log "$bdf" 0
        fi
    fi

    if [[ -n "$vm" && -x "$(command -v "$INCUS_BIN" 2>/dev/null || true)" ]]; then
        load_instances
        load_vm "$vm"
        printf '\nVM: %s type=%s status=%s location=%s\n' "$vm" "$VM_TYPE" "$VM_STATUS" "${VM_LOCATION:--}"
        if ! check_cluster_location "$vm" 0; then
            ((failures += 1))
        fi
        local gpu_lines
        gpu_lines=$(instance_gpu_devices "$vm" expanded || true)
        if [[ -n "$gpu_lines" ]]; then
            printf 'Configured GPU devices:\n%s\n' "$gpu_lines"
        else
            printf 'Configured GPU devices: none\n'
        fi
    fi

    printf '\n'
    if ((failures == 0)); then
        ok "重大な前提不足は検出されませんでした。"
    else
        warn "$failures 件の重大な前提不足を検出しました。"
        return 1
    fi
}

main() {
    local command=${1:-}
    if [[ -z "$command" ]]; then
        usage
        return 1
    fi
    shift || true

    case "$command" in
        list|ls) cmd_list "$@" ;;
        doctor|check) cmd_doctor "$@" ;;
        inspect|probe|diagnose) cmd_inspect "$@" ;;
        attach|add) cmd_attach "$@" ;;
        detach|remove|rm) cmd_detach "$@" ;;
        status|show) cmd_status "$@" ;;
        bind-vfio|vfio-bind) cmd_bind_vfio "$@" ;;
        release-vfio|vfio-release|unbind-vfio) cmd_release_vfio "$@" ;;
        prepare-host|prepare) cmd_prepare_host "$@" ;;
        version|--version|-V) printf '%s\n' "$VERSION" ;;
        help|--help|-h) usage ;;
        *)
            # 短縮形: incus-gpu VM GPU [options]
            cmd_attach "$command" "$@"
            ;;
    esac
}

main "$@"
