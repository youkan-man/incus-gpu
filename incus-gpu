#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.1.6"
PROG="${0##*/}"

SYSFS_ROOT="${INCUS_GPU_SYSFS_ROOT:-/sys}"
PROC_ROOT="${INCUS_GPU_PROC_ROOT:-/proc}"
ETC_ROOT="${INCUS_GPU_ETC_ROOT:-/etc}"
DEV_ROOT="${INCUS_GPU_DEV_ROOT:-/dev}"
INCUS_BIN="${INCUS_GPU_INCUS_BIN:-incus}"
LSPCI_BIN="${INCUS_GPU_LSPCI_BIN:-lspci}"
PYTHON_BIN="${INCUS_GPU_PYTHON_BIN:-python3}"

PROJECT="${INCUS_PROJECT:-}"
DRY_RUN=0
FORCE=0
YES=0
STOP_MODE="none" # none | stop | restart
START_REQUESTED=0
FORCE_STOP=0
STOP_TIMEOUT=60
KEEP_ON_START_FAILURE=0
PREBIND_VFIO=0
VFIO_BIND_TIMEOUT=15
SYSFS_WRITE_STUCK_PID=""
SYSFS_WRITE_STUCK_PATH=""
SYSFS_WRITE_STUCK_LABEL=""
SYSFS_WRITE_STUCK_STATE=""
SYSFS_WRITE_STUCK_WCHAN=""
SYSFS_WRITE_STUCK_TMPDIR=""
INCUS_LIST_JSON=""
VM_TYPE=""
VM_STATUS=""
VM_LOCATION=""
VM_ORIGINALLY_RUNNING=0
VM_SHOULD_START=0
declare -a PREBOUND_FUNCTIONS=()
declare -A PREBIND_ORIGINAL_DRIVER=()
declare -A PREBIND_ORIGINAL_OVERRIDE=()

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\033[31m'
    C_YELLOW=$'\033[33m'
    C_GREEN=$'\033[32m'
    C_BLUE=$'\033[34m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_RED=""
    C_YELLOW=""
    C_GREEN=""
    C_BLUE=""
    C_BOLD=""
    C_RESET=""
fi

info() { printf '%s[INFO]%s %s\n' "$C_BLUE" "$C_RESET" "$*" >&2; }
ok()   { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*" >&2; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

usage() {
    cat <<EOF_USAGE
${C_BOLD}incus-gpu ${VERSION}${C_RESET} - Ubuntu/Incus VM向けGPUパススルー管理ツール

使い方:
  ${PROG} list
  ${PROG} doctor [--vm VM] [--gpu GPU] [--kernel-log]
  sudo ${PROG} inspect VM GPU [--project NAME] [--timeout SEC]
  ${PROG} attach VM GPU [オプション]
  ${PROG} detach VM [GPU] [オプション]
  ${PROG} status VM
  sudo ${PROG} bind-vfio GPU [--timeout SEC] [--force]
  sudo ${PROG} release-vfio GPU [--force]
  sudo ${PROG} prepare-host [--yes]
  sudo ${PROG} prepare-host --undo [--yes]

短縮形:
  ${PROG} VM GPU [オプション]        # attach と同じ

GPU指定:
  1                    list の番号（1始まり）
  0000:01:00.0         完全なPCI BDF
  01:00.0              短いPCI BDF
  RTX、NVIDIA、Radeon  lspci表示名の一意な部分文字列
  auto                 非boot VGAのGPUが1台だけなら自動選択

attach/detachオプション:
  --device NAME         Incusデバイス名（attach）または削除対象名（detach）
  --project NAME        Incusプロジェクト
  --stop                VMが稼働中なら停止し、停止したままにする
  --restart             VMが稼働中なら停止し、処理後に再起動する
  --start               処理後にVMを起動する
  --timeout SEC         通常停止の待機秒数（既定: 60）
  --force-stop          通常停止失敗時に強制停止する
  --force               boot VGA、使用中GPU、重複割当等の保護を解除
  --prebind-vfio        Incus起動前にGPU機能をvfio-pciへ事前バインド
  --vfio-timeout SEC    事前バインドの待機秒数（既定: 15）
                       bind/probe書込みも監視し、カーネル停止時でも制御を返す
  --keep-on-failure     attach後のVM起動失敗時にGPU設定を残す
  --dry-run             変更コマンドを表示するだけ

doctorオプション:
  --vm VM               対象VMを確認
  --gpu GPU             対象GPUとIOMMU/VFIO状態を確認
  --project NAME        Incusプロジェクト
  --kernel-log          対象GPU、VFIO、IOMMUに関係するカーネルログも表示

inspectオプション:
  --project NAME        Incusプロジェクト
  --timeout SEC         各PCI sysfs操作の監視秒数（既定: 15）
  --force-stop          VMの通常停止失敗時に強制停止
  --force               保護判定を解除して精査
  --dry-run             停止・PCI操作・復旧コマンドだけを表示

例:
  ${PROG} list
  ${PROG} doctor --vm ai-vm --gpu 1 --kernel-log
  sudo ${PROG} inspect ai-vm 0000:41:00.0 --project default
  ${PROG} attach ai-vm 0000:41:00.0 --restart
  ${PROG} detach ai-vm 0000:41:00.0 --restart
EOF_USAGE
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "必要なコマンドがありません: $1"
}

print_command() {
    local arg
    printf '+ ' >&2
    for arg in "$@"; do
        printf '%q ' "$arg" >&2
    done
    printf '\n' >&2
}

incus_base_command() {
    local -n _out=$1
    _out=("$INCUS_BIN" --force-local)
    if [[ -n "$PROJECT" ]]; then
        _out+=(--project "$PROJECT")
    fi
}

incus_read() {
    local cmd
    incus_base_command cmd
    "${cmd[@]}" "$@"
}

incus_mutate() {
    local cmd
    incus_base_command cmd
    cmd+=("$@")
    if (( DRY_RUN )); then
        print_command "${cmd[@]}"
        return 0
    fi
    "${cmd[@]}"
}

host_mutate() {
    if (( DRY_RUN )); then
        print_command "$@"
        return 0
    fi
    "$@"
}

normalize_bdf() {
    local value="${1,,}"
    if [[ "$value" =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]]; then
        printf '%s\n' "$value"
    elif [[ "$value" =~ ^[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]]; then
        printf '0000:%s\n' "$value"
    else
        return 1
    fi
}

pci_path() {
    printf '%s/bus/pci/devices/%s\n' "$SYSFS_ROOT" "$1"
}

pci_class() {
    local file
    file="$(pci_path "$1")/class"
    [[ -r "$file" ]] && tr 'A-F' 'a-f' < "$file" || printf 'unknown\n'
}

pci_id_value() {
    local bdf=$1 field=$2 file value
    file="$(pci_path "$bdf")/$field"
    if [[ -r "$file" ]]; then
        value=$(<"$file")
        printf '%s\n' "${value#0x}"
    else
        printf '????\n'
    fi
}

pci_driver() {
    local link
    link="$(pci_path "$1")/driver"
    if [[ -L "$link" ]]; then
        basename "$(readlink -f "$link")"
    else
        printf -- '-\n'
    fi
}

pci_iommu_group() {
    local link
    link="$(pci_path "$1")/iommu_group"
    if [[ -L "$link" ]]; then
        basename "$(readlink -f "$link")"
    else
        printf -- '-\n'
    fi
}

pci_boot_vga() {
    local file
    file="$(pci_path "$1")/boot_vga"
    [[ -r "$file" ]] && cat "$file" || printf '0\n'
}

pci_description() {
    local bdf=$1 out vendor product
    if command -v "$LSPCI_BIN" >/dev/null 2>&1; then
        out=$("$LSPCI_BIN" -s "$bdf" -nn 2>/dev/null | head -n 1 || true)
        if [[ -n "$out" ]]; then
            out="${out#* }"
            printf '%s\n' "$out"
            return 0
        fi
    fi

    vendor=$(pci_id_value "$bdf" vendor)
    product=$(pci_id_value "$bdf" device)
    printf 'PCI display controller [%s:%s]\n' "$vendor" "$product"
}

gpu_bdfs() (
    shopt -s nullglob
    local path class
    for path in "$SYSFS_ROOT"/bus/pci/devices/*; do
        [[ -r "$path/class" ]] || continue
        class=$(tr 'A-F' 'a-f' < "$path/class")
        case "$class" in
            0x03*) basename "$path" ;;
        esac
    done | LC_ALL=C sort
)

list_gpus() {
    local -a gpus
    local idx=0 bdf group driver boot desc
    mapfile -t gpus < <(gpu_bdfs)

    if ((${#gpus[@]} == 0)); then
        warn "GPUクラスのPCIデバイスが見つかりません。"
        return 1
    fi

    printf '%-4s %-12s %-7s %-13s %-6s %s\n' 'No.' 'PCI BDF' 'IOMMU' 'HOST DRIVER' 'BOOT' 'DEVICE'
    for bdf in "${gpus[@]}"; do
        ((idx += 1))
        group=$(pci_iommu_group "$bdf")
        driver=$(pci_driver "$bdf")
        boot=$(pci_boot_vga "$bdf")
        [[ "$boot" == "1" ]] && boot='yes' || boot='no'
        desc=$(pci_description "$bdf")
        printf '%-4s %-12s %-7s %-13s %-6s %s\n' "$idx" "${bdf#0000:}" "$group" "$driver" "$boot" "$desc"
    done
}

resolve_gpu() {
    local selector=$1 normalized selector_lc bdf hay
    local -a gpus=() matches=() candidates=()
    mapfile -t gpus < <(gpu_bdfs)
    ((${#gpus[@]} > 0)) || die "GPUが見つかりません。"

    if normalized=$(normalize_bdf "$selector" 2>/dev/null); then
        [[ -d "$(pci_path "$normalized")" ]] || die "PCIデバイスが存在しません: $normalized"
        [[ "$(pci_class "$normalized")" == 0x03* ]] || die "指定デバイスはGPUクラスではありません: $normalized"
        printf '%s\n' "$normalized"
        return 0
    fi

    if [[ "$selector" =~ ^#?([0-9]+)$ ]]; then
        local number=$((10#${BASH_REMATCH[1]}))
        (( number >= 1 && number <= ${#gpus[@]} )) || die "GPU番号が範囲外です: $selector"
        printf '%s\n' "${gpus[number-1]}"
        return 0
    fi

    if [[ "${selector,,}" == "auto" ]]; then
        for bdf in "${gpus[@]}"; do
            [[ "$(pci_boot_vga "$bdf")" == "1" ]] || candidates+=("$bdf")
        done
        if ((${#candidates[@]} == 1)); then
            printf '%s\n' "${candidates[0]}"
            return 0
        fi
        warn "autoで一意に選べません。"
        list_gpus >&2 || true
        die "PCI BDFまたはlist番号を指定してください。"
    fi

    selector_lc=${selector,,}
    for bdf in "${gpus[@]}"; do
        hay="${bdf} $(pci_description "$bdf") $(pci_id_value "$bdf" vendor):$(pci_id_value "$bdf" device)"
        if [[ "${hay,,}" == *"$selector_lc"* ]]; then
            matches+=("$bdf")
        fi
    done

    if ((${#matches[@]} == 1)); then
        printf '%s\n' "${matches[0]}"
        return 0
    fi

    if ((${#matches[@]} > 1)); then
        warn "GPU指定 '$selector' が複数台に一致しました: ${matches[*]}"
        list_gpus >&2 || true
        die "より具体的なPCI BDFを指定してください。"
    fi

    list_gpus >&2 || true
    die "GPU指定を解決できません: $selector"
}

load_instances() {
    require_cmd "$INCUS_BIN"
    require_cmd "$PYTHON_BIN"
    INCUS_LIST_JSON=$(incus_read list --format=json) || die "Incusインスタンス一覧を取得できません。"
}

instance_record() {
    local vm=$1
    "$PYTHON_BIN" -c '
import json, sys
name = sys.argv[1]
data = json.load(sys.stdin)
if isinstance(data, dict) and "metadata" in data:
    data = data["metadata"]
for inst in data:
    if inst.get("name") == name:
        print("\t".join([
            str(inst.get("type", "")),
            str(inst.get("status", "")),
            str(inst.get("location", "")),
        ]))
        raise SystemExit(0)
raise SystemExit(3)
' "$vm" <<<"$INCUS_LIST_JSON"
}

load_vm() {
    local vm=$1 record
    record=$(instance_record "$vm") || die "Incusインスタンスが見つかりません: $vm"
    IFS=$'\t' read -r VM_TYPE VM_STATUS VM_LOCATION <<<"$record"
    [[ "$VM_TYPE" == "virtual-machine" ]] || die "対象はIncus VMではありません: $vm (type=$VM_TYPE)"
}

instance_gpu_devices() {
    local vm=$1 mode=${2:-expanded}
    "$PYTHON_BIN" -c '
import json, sys
name, mode = sys.argv[1], sys.argv[2]
data = json.load(sys.stdin)
if isinstance(data, dict) and "metadata" in data:
    data = data["metadata"]
for inst in data:
    if inst.get("name") != name:
        continue
    direct = inst.get("devices") or {}
    expanded = inst.get("expanded_devices") or direct
    source = direct if mode == "direct" else expanded
    for dev_name in sorted(source):
        dev = source.get(dev_name) or {}
        if dev.get("type") != "gpu":
            continue
        origin = "local" if dev_name in direct and (direct.get(dev_name) or {}).get("type") == "gpu" else "profile"
        print("\t".join([
            dev_name,
            str(dev.get("pci", "")),
            str(dev.get("gputype", "physical")),
            origin,
        ]))
    raise SystemExit(0)
raise SystemExit(3)
' "$vm" "$mode" <<<"$INCUS_LIST_JSON"
}

device_name_exists() {
    local vm=$1 device_name=$2
    "$PYTHON_BIN" -c '
import json, sys
name, wanted = sys.argv[1], sys.argv[2]
data = json.load(sys.stdin)
if isinstance(data, dict) and "metadata" in data:
    data = data["metadata"]
for inst in data:
    if inst.get("name") == name:
        devices = inst.get("expanded_devices") or inst.get("devices") or {}
        raise SystemExit(0 if wanted in devices else 1)
raise SystemExit(2)
' "$vm" "$device_name" <<<"$INCUS_LIST_JSON"
}

gpu_assignments() {
    local wanted=$1
    "$PYTHON_BIN" -c '
import json, sys
wanted = sys.argv[1].lower()
def norm(v):
    v = str(v or "").lower()
    if len(v) == 7 and v.count(":") == 1:
        return "0000:" + v
    return v
data = json.load(sys.stdin)
if isinstance(data, dict) and "metadata" in data:
    data = data["metadata"]
for inst in data:
    devices = inst.get("expanded_devices") or inst.get("devices") or {}
    for dev_name, dev in devices.items():
        if (dev or {}).get("type") == "gpu" and norm((dev or {}).get("pci")) == wanted:
            print("\t".join([
                str(inst.get("name", "")),
                str(dev_name),
                str(inst.get("status", "")),
            ]))
' "$wanted" <<<"$INCUS_LIST_JSON"
}

choose_device_name() {
    local vm=$1 bdf=$2 requested=${3:-} base candidate suffix=1
    if [[ -n "$requested" ]]; then
        [[ "$requested" =~ ^[A-Za-z0-9_.-]+$ ]] || die "不正なIncusデバイス名です: $requested"
        if device_name_exists "$vm" "$requested"; then
            die "同名のIncusデバイスが既に存在します: $requested"
        fi
        printf '%s\n' "$requested"
        return 0
    fi

    base="gpu-${bdf#0000:}"
    base=${base//:/-}
    base=${base//./-}
    candidate=$base
    while device_name_exists "$vm" "$candidate"; do
        ((suffix += 1))
        candidate="${base}-${suffix}"
    done
    printf '%s\n' "$candidate"
}

check_cluster_location() {
    local vm=$1 fatal=${2:-1} server_json record clustered server_name
    server_json=$(incus_read query /1.0 2>/dev/null || true)
    [[ -n "$server_json" ]] || return 0
    record=$("$PYTHON_BIN" -c '
import json, sys
data = json.load(sys.stdin)
if isinstance(data, dict) and "metadata" in data:
    data = data["metadata"]
env = data.get("environment") or {}
clustered = env.get("server_clustered", False)
print(("true" if clustered else "false") + "\t" + str(env.get("server_name", "")))
' <<<"$server_json" 2>/dev/null || true)
    [[ -n "$record" ]] || return 0
    IFS=$'\t' read -r clustered server_name <<<"$record"
    if [[ "$clustered" == "true" && -n "$VM_LOCATION" && "$VM_LOCATION" != "none" && "$VM_LOCATION" != "$server_name" ]]; then
        local message="VM '$vm' はクラスタメンバー '$VM_LOCATION' 上にあります。このツールをそのメンバー上で実行してください（現在: '$server_name'）。"
        if (( fatal )); then
            die "$message"
        fi
        warn "$message"
        return 1
    fi
}

is_bridge_class() {
    local class driver
    class=$(pci_class "$1")
    driver=$(pci_driver "$1")

    # PCI-to-PCI bridges were already ignored because they are topology
    # devices rather than assignable endpoints. Some AMD platforms also
    # place an unbound host bridge (for example class 0x060000) in the same
    # IOMMU group as a GPU. An unbound bridge is not required to use vfio-pci.
    [[ "$class" == 0x0604* ]] || [[ "$class" == 0x06* && "$driver" == "-" ]]
}

pci_driver_override() {
    local file value
    file="$(pci_path "$1")/driver_override"
    if [[ ! -r "$file" ]]; then
        printf -- '-\n'
        return 0
    fi

    value=$(tr -d '\000\r\n' < "$file" 2>/dev/null || true)
    case "$value" in
        ''|'(null)') printf -- '-\n' ;;
        *) printf '%s\n' "$value" ;;
    esac
}

iommu_group_members() {
    local -n _members=$1
    local bdf=$2 path group_path member
    _members=()
    path=$(pci_path "$bdf")
    group_path=$(readlink -f "$path/iommu_group" 2>/dev/null || true)
    [[ -d "$group_path/devices" ]] || return 0

    shopt -s nullglob
    for member in "$group_path"/devices/*; do
        _members+=("$(basename "$member")")
    done
    shopt -u nullglob
}


pci_slot_functions() {
    local -n _functions=$1
    local bdf=$2 member prefix
    local -a members=()
    _functions=()
    prefix=${bdf%.*}
    iommu_group_members members "$bdf"

    for member in "${members[@]}"; do
        [[ "${member%.*}" == "$prefix" ]] && _functions+=("$member")
    done

    ((${#_functions[@]} > 0)) || _functions=("$bdf")
}

require_sysfs_write_access() {
    (( DRY_RUN )) && return 0
    if [[ "$SYSFS_ROOT" == "/sys" ]] && (( EUID != 0 )); then
        warn "VFIOの事前バインドはroot権限が必要です。sudoで実行してください。"
        return 1
    fi
    if [[ ! -w "$SYSFS_ROOT/bus/pci/drivers_probe" ]]; then
        warn "PCI drivers_probeへ書き込めません: $SYSFS_ROOT/bus/pci/drivers_probe"
        return 1
    fi
}

sysfs_write() {
    local value=$1 path=$2
    if (( DRY_RUN )); then
        printf '+ write %q > %q\n' "$value" "$path" >&2
        return 0
    fi
    [[ -e "$path" ]] || {
        warn "sysfsパスがありません: $path"
        return 1
    }
    printf '%s\n' "$value" > "$path"
}

sysfs_write_checked() {
    local value=$1 path=$2 label=${3:-sysfs-write}
    local err_file rc err
    if (( DRY_RUN )); then
        printf '+ write %q > %q  # %s\n' "$value" "$path" "$label" >&2
        return 0
    fi
    [[ -e "$path" ]] || {
        warn "$label: sysfsパスがありません: $path"
        return 1
    }

    err_file=$(mktemp)
    if printf '%s\n' "$value" 2>"$err_file" >"$path"; then
        rm -f "$err_file"
        return 0
    else
        rc=$?
        err=$(tr '\n' ' ' <"$err_file" 2>/dev/null || true)
        rm -f "$err_file"
        warn "$label に失敗しました (exit=$rc, path=$path): ${err:-kernel rejected the write}"
        return "$rc"
    fi
}

sysfs_write_watchdog() {
    local value=$1 path=$2 label=${3:-sysfs-write} timeout=${4:-$VFIO_BIND_TIMEOUT}
    local work_dir err_file rc_file worker_pid deadline rc err state wchan

    if (( DRY_RUN )); then
        printf '+ write %q > %q  # %s (watchdog=%ss)\n' \
            "$value" "$path" "$label" "$timeout" >&2
        return 0
    fi

    [[ -e "$path" ]] || {
        warn "$label: sysfsパスがありません: $path"
        return 1
    }

    SYSFS_WRITE_STUCK_PID=""
    SYSFS_WRITE_STUCK_PATH=""
    SYSFS_WRITE_STUCK_LABEL=""
    SYSFS_WRITE_STUCK_STATE=""
    SYSFS_WRITE_STUCK_WCHAN=""
    SYSFS_WRITE_STUCK_TMPDIR=""

    work_dir=$(mktemp -d)
    err_file="$work_dir/stderr"
    rc_file="$work_dir/rc"

    (
        set +e
        # stderrを先にリダイレクトし、sysfsのopen/writeエラーも採取する。
        printf '%s\n' "$value" 2>"$err_file" >"$path"
        rc=$?
        printf '%s\n' "$rc" >"$rc_file"
        exit "$rc"
    ) &
    worker_pid=$!
    deadline=$((SECONDS + timeout))

    while [[ ! -s "$rc_file" ]]; do
        if ! kill -0 "$worker_pid" 2>/dev/null; then
            break
        fi

        if (( SECONDS >= deadline )); then
            warn "$label が${timeout}秒を超えて応答しません。監視ワーカーPID=$worker_pid"
            kill -TERM "$worker_pid" 2>/dev/null || true
            sleep 0.5
            kill -KILL "$worker_pid" 2>/dev/null || true
            sleep 0.5

            state=$(ps -o stat= -p "$worker_pid" 2>/dev/null | awk '{print $1}' || true)
            if [[ "$state" == Z* || -z "$state" ]]; then
                wait "$worker_pid" 2>/dev/null || true
                err=$(tr '\n' ' ' <"$err_file" 2>/dev/null || true)
                rm -rf "$work_dir"
                warn "$label をタイムアウトで中断しました。${err:+詳細: $err}"
                return 124
            fi

            wchan=$(cat "/proc/$worker_pid/wchan" 2>/dev/null || true)
            SYSFS_WRITE_STUCK_PID=$worker_pid
            SYSFS_WRITE_STUCK_PATH=$path
            SYSFS_WRITE_STUCK_LABEL=$label
            SYSFS_WRITE_STUCK_STATE=$state
            SYSFS_WRITE_STUCK_WCHAN=${wchan:-unknown}
            SYSFS_WRITE_STUCK_TMPDIR=$work_dir
            disown "$worker_pid" 2>/dev/null || true

            warn "sysfsワーカーがカーネル待ちのまま残っています: pid=$worker_pid state=$state wchan=${wchan:-unknown}"
            warn "このPCI操作はまだ進行中の可能性があるため、復元・VM再起動を自動実行しません。"
            warn "確認: ps -o pid,ppid,stat,wchan:32,cmd -p $worker_pid"
            warn "state=Dのままなら、通常のkillでは解消せずホスト再起動が必要です。"
            return 124
        fi

        sleep 0.1
    done

    if [[ -s "$rc_file" ]]; then
        rc=$(cat "$rc_file" 2>/dev/null || printf '1')
    else
        wait "$worker_pid" 2>/dev/null
        rc=$?
    fi
    wait "$worker_pid" 2>/dev/null || true
    err=$(tr '\n' ' ' <"$err_file" 2>/dev/null || true)
    rm -rf "$work_dir"

    if (( rc == 0 )); then
        return 0
    fi

    warn "$label に失敗しました (exit=$rc, path=$path): ${err:-kernel rejected the write}"
    return "$rc"
}

load_vfio_pci_driver() {
    local driver_path="$SYSFS_ROOT/bus/pci/drivers/vfio-pci"
    [[ -d "$driver_path" ]] && return 0

    if (( DRY_RUN )); then
        print_command modprobe vfio-pci
        return 0
    fi

    command -v modprobe >/dev/null 2>&1 || {
        warn "modprobeがないためvfio-pciをロードできません。"
        return 1
    }
    modprobe vfio-pci || return 1
    [[ -d "$driver_path" ]] || {
        warn "vfio-pciロード後もドライバーパスがありません: $driver_path"
        return 1
    }
}

wait_for_pci_driver() {
    local bdf=$1 expected=$2 timeout=$3 deadline current
    (( DRY_RUN )) && return 0
    deadline=$((SECONDS + timeout))
    while :; do
        current=$(pci_driver "$bdf")
        [[ "$current" == "$expected" ]] && return 0
        (( SECONDS >= deadline )) && break
        sleep 0.1
    done
    return 1
}

unbind_pci_function() {
    local bdf=$1 timeout=${2:-$VFIO_BIND_TIMEOUT} driver unbind_path rc
    driver=$(pci_driver "$bdf")
    [[ "$driver" == "-" ]] && return 0
    unbind_path="$SYSFS_ROOT/bus/pci/drivers/$driver/unbind"

    if sysfs_write_watchdog "$bdf" "$unbind_path" \
        "PCI driver unbind ($bdf from $driver)" "$timeout"; then
        return 0
    else
        rc=$?
        return "$rc"
    fi
}

bind_pci_function_to_vfio() {
    local bdf=$1 timeout=$2 current override_path bind_path probe_path bind_epoch rc
    current=$(pci_driver "$bdf")
    if [[ "$current" == "vfio-pci" ]]; then
        info "$bdf は既にvfio-pciへバインドされています。"
        return 0
    fi

    info "$bdf を${current}からvfio-pciへ切り替えます。"
    if unbind_pci_function "$bdf" "$timeout"; then
        :
    else
        rc=$?
        [[ -n "$SYSFS_WRITE_STUCK_PID" ]] && return 124
        warn "$bdf のホストドライバー解除に失敗しました。"
        print_pci_diagnostics "$bdf"
        return "$rc"
    fi

    override_path="$(pci_path "$bdf")/driver_override"
    if sysfs_write_watchdog 'vfio-pci' "$override_path" \
        "driver_override設定 ($bdf)" "$timeout"; then
        :
    else
        rc=$?
        [[ -n "$SYSFS_WRITE_STUCK_PID" ]] && return 124
        warn "$bdf のdriver_override設定が完了しませんでした。"
        print_pci_diagnostics "$bdf"
        return "$rc"
    fi

    bind_path="$SYSFS_ROOT/bus/pci/drivers/vfio-pci/bind"
    probe_path="$SYSFS_ROOT/bus/pci/drivers_probe"
    bind_epoch=$(date +%s)

    # PCI driver probeはカーネル内で長時間停止することがあるため、
    # メインシェルでは実行せず監視付きワーカーへ分離する。
    if [[ -e "$bind_path" ]] || (( DRY_RUN )); then
        if sysfs_write_watchdog "$bdf" "$bind_path" \
            "vfio-pci direct bind ($bdf)" "$timeout"; then
            :
        else
            rc=$?
            [[ -n "$SYSFS_WRITE_STUCK_PID" ]] && return 124
            warn "$bdf のvfio-pci probeが完了しませんでした。"
            print_pci_diagnostics "$bdf"
            print_kernel_vfio_log "$bdf" "$bind_epoch"
            return "$rc"
        fi
    else
        warn "vfio-pci/bindが無いためdrivers_probeへフォールバックします。"
        if sysfs_write_watchdog "$bdf" "$probe_path" \
            "PCI drivers_probe ($bdf)" "$timeout"; then
            :
        else
            rc=$?
            [[ -n "$SYSFS_WRITE_STUCK_PID" ]] && return 124
            print_pci_diagnostics "$bdf"
            print_kernel_vfio_log "$bdf" "$bind_epoch"
            return "$rc"
        fi
    fi

    if ! wait_for_pci_driver "$bdf" vfio-pci "$timeout"; then
        warn "$bdf が${timeout}秒以内にvfio-pciへバインドされませんでした。"
        print_pci_diagnostics "$bdf"
        print_kernel_vfio_log "$bdf" "$bind_epoch"
        return 1
    fi
    ok "$bdf -> vfio-pci"
}

restore_pci_function() {
    local bdf=$1 original_driver=$2 original_override=$3 timeout=${4:-$VFIO_BIND_TIMEOUT}
    local current override_path restore_override rc
    current=$(pci_driver "$bdf")
    if [[ "$current" != "-" ]]; then
        if unbind_pci_function "$bdf" "$timeout"; then
            :
        else
            rc=$?
            return "$rc"
        fi
    fi

    override_path="$(pci_path "$bdf")/driver_override"
    if [[ "$original_override" == "-" ]]; then
        restore_override=''
    else
        restore_override=$original_override
    fi

    if sysfs_write_watchdog "$restore_override" "$override_path" \
        "driver_override復元 ($bdf)" "$timeout"; then
        :
    else
        rc=$?
        return "$rc"
    fi

    if [[ "$original_driver" != "-" ]]; then
        if command -v modprobe >/dev/null 2>&1; then
            modprobe "$original_driver" >/dev/null 2>&1 || true
        fi
        if sysfs_write_watchdog "$bdf" "$SYSFS_ROOT/bus/pci/drivers_probe" \
            "PCI driver復元probe ($bdf -> $original_driver)" "$timeout"; then
            :
        else
            rc=$?
            return "$rc"
        fi
        if ! wait_for_pci_driver "$bdf" "$original_driver" "$timeout"; then
            warn "$bdf を元のドライバー $original_driver へ戻せませんでした。"
            return 1
        fi
    fi
}

restore_prebound_vfio() {
    local index bdf failed=0 rc
    ((${#PREBOUND_FUNCTIONS[@]} > 0)) || return 0
    warn "事前バインドしたPCI機能を元の状態へ戻します。"
    for ((index=${#PREBOUND_FUNCTIONS[@]}-1; index>=0; index--)); do
        bdf=${PREBOUND_FUNCTIONS[index]}
        if restore_pci_function "$bdf" \
            "${PREBIND_ORIGINAL_DRIVER[$bdf]}" \
            "${PREBIND_ORIGINAL_OVERRIDE[$bdf]}" "$VFIO_BIND_TIMEOUT"; then
            :
        else
            rc=$?
            failed=1
            warn "$bdf のPCI状態を完全には復元できませんでした (exit=$rc)。"
            [[ -n "$SYSFS_WRITE_STUCK_PID" ]] && break
        fi
    done
    PREBOUND_FUNCTIONS=()
    PREBIND_ORIGINAL_DRIVER=()
    PREBIND_ORIGINAL_OVERRIDE=()
    return "$failed"
}

prebind_vfio_functions() {
    local bdf=$1 timeout=$2 function original_driver original_override group current rc
    local vfio_count=0 host_count=0
    local -a functions=()
    PREBOUND_FUNCTIONS=()
    PREBIND_ORIGINAL_DRIVER=()
    PREBIND_ORIGINAL_OVERRIDE=()

    require_sysfs_write_access || return 1
    load_vfio_pci_driver || return 1
    pci_slot_functions functions "$bdf"

    for function in "${functions[@]}"; do
        current=$(pci_driver "$function")
        if [[ "$current" == "vfio-pci" ]]; then
            ((vfio_count += 1))
        else
            ((host_count += 1))
        fi
    done

    if (( vfio_count > 0 && host_count > 0 )); then
        warn "GPU機能が部分的にvfio-pciへバインドされています。前回失敗の残留状態の可能性があります。"
        print_vfio_state "$bdf"
        warn "完全に戻してやり直す場合: sudo ${PROG} release-vfio $bdf --force"
    fi

    group=$(pci_iommu_group "$bdf")
    if [[ "$group" != "-" && -e "$DEV_ROOT/vfio/$group" ]] && \
       command -v fuser >/dev/null 2>&1 && \
       fuser -s "$DEV_ROOT/vfio/$group" 2>/dev/null; then
        warn "VFIOグループ $group はプロセスが使用中です: $DEV_ROOT/vfio/$group"
        fuser -v "$DEV_ROOT/vfio/$group" 2>&1 | sed 's/^/  /' >&2 || true
        (( FORCE )) || return 1
    fi

    for function in "${functions[@]}"; do
        original_driver=$(pci_driver "$function")
        original_override=$(pci_driver_override "$function")
        if [[ "$original_driver" == "vfio-pci" ]]; then
            info "$function は既にvfio-pciへバインドされています。"
            continue
        fi

        PREBOUND_FUNCTIONS+=("$function")
        PREBIND_ORIGINAL_DRIVER["$function"]=$original_driver
        PREBIND_ORIGINAL_OVERRIDE["$function"]=$original_override

        if bind_pci_function_to_vfio "$function" "$timeout"; then
            continue
        else
            rc=$?
        fi

        warn "VFIO事前バインドに失敗しました: $function"
        if [[ -n "$SYSFS_WRITE_STUCK_PID" ]]; then
            warn "カーネル内のbind/probeが終了していないため、PCI状態の復元を省略します。"
            warn "対象: $SYSFS_WRITE_STUCK_LABEL path=$SYSFS_WRITE_STUCK_PATH"
            warn "worker: pid=$SYSFS_WRITE_STUCK_PID state=$SYSFS_WRITE_STUCK_STATE wchan=$SYSFS_WRITE_STUCK_WCHAN"
            return 124
        fi

        print_vfio_state "$bdf"
        restore_prebound_vfio || true
        return "$rc"
    done

    print_vfio_state "$bdf"
}

release_vfio_functions() {
    local bdf=$1 group function current changed=0 rc
    local -a functions=()
    require_sysfs_write_access || return 1
    group=$(pci_iommu_group "$bdf")

    if [[ "$group" != "-" && -e "$DEV_ROOT/vfio/$group" ]] && \
       command -v fuser >/dev/null 2>&1 && \
       fuser -s "$DEV_ROOT/vfio/$group" 2>/dev/null; then
        warn "VFIOグループ $group はプロセスが使用中です。"
        (( FORCE )) || die "VMを停止するか、内容を確認して --force を付けてください。"
    fi

    pci_slot_functions functions "$bdf"
    for function in "${functions[@]}"; do
        current=$(pci_driver "$function")
        [[ "$current" == "vfio-pci" ]] || continue
        changed=1
        info "$function をvfio-pciから解放してホストへ再probeします。"
        if unbind_pci_function "$function" "$VFIO_BIND_TIMEOUT"; then
            :
        else
            rc=$?
            return "$rc"
        fi
        if sysfs_write_watchdog '' "$(pci_path "$function")/driver_override" \
            "driver_override解除 ($function)" "$VFIO_BIND_TIMEOUT"; then
            :
        else
            rc=$?
            return "$rc"
        fi
        if sysfs_write_watchdog "$function" "$SYSFS_ROOT/bus/pci/drivers_probe" \
            "ホストドライバー再probe ($function)" "$VFIO_BIND_TIMEOUT"; then
            :
        else
            rc=$?
            return "$rc"
        fi
        if (( ! DRY_RUN )); then
            sleep 0.2
            info "$function の現在のドライバー: $(pci_driver "$function")"
        fi
    done

    (( changed )) || info "vfio-pciへバインドされた対象機能はありません。"
    print_vfio_state "$bdf"
}


print_pci_diagnostics() {
    local bdf=$1 group function field value group_type
    local -a functions=()
    local -a fields=(
        vendor device subsystem_vendor subsystem_device class revision
        enable numa_node boot_vga current_link_speed current_link_width
        max_link_speed max_link_width power_state d3cold_allowed reset_method
        modalias
    )

    group=$(pci_iommu_group "$bdf")
    pci_slot_functions functions "$bdf"

    printf '%s\n' '--- PCI/VFIO diagnostic detail ---' >&2
    printf 'Kernel: %s\n' "$(uname -a 2>/dev/null || printf unknown)" >&2
    if [[ -r "$PROC_ROOT/cmdline" ]]; then
        printf 'Kernel cmdline: %s\n' "$(cat "$PROC_ROOT/cmdline")" >&2
    fi
    if [[ "$group" != "-" && -r "$SYSFS_ROOT/kernel/iommu_groups/$group/type" ]]; then
        group_type=$(cat "$SYSFS_ROOT/kernel/iommu_groups/$group/type" 2>/dev/null || true)
        printf 'IOMMU group %s type: %s\n' "$group" "${group_type:-unknown}" >&2
    fi

    if [[ "$group" != "-" && -e "$DEV_ROOT/vfio/$group" ]] && command -v fuser >/dev/null 2>&1; then
        if fuser -s "$DEV_ROOT/vfio/$group" 2>/dev/null; then
            printf 'VFIO group users (%s):\n' "$DEV_ROOT/vfio/$group" >&2
            fuser -v "$DEV_ROOT/vfio/$group" 2>&1 | sed 's/^/  /' >&2 || true
        else
            printf 'VFIO group users: none detected\n' >&2
        fi
    fi

    for function in "${functions[@]}"; do
        printf '\n[%s] driver=%s override=%s iommu=%s\n' \
            "$function" "$(pci_driver "$function")" \
            "$(pci_driver_override "$function")" "$(pci_iommu_group "$function")" >&2

        for field in "${fields[@]}"; do
            if [[ -r "$(pci_path "$function")/$field" ]]; then
                value=$(tr '\000\r\n' ' ' <"$(pci_path "$function")/$field" 2>/dev/null || true)
                printf '  %-20s %s\n' "$field:" "${value:-<empty>}" >&2
            fi
        done

        if [[ -r "$(pci_path "$function")/power/control" ]]; then
            value=$(tr '\000\r\n' ' ' <"$(pci_path "$function")/power/control" 2>/dev/null || true)
            printf '  %-20s %s\n' 'power/control:' "${value:-<empty>}" >&2
        fi

        if [[ -r "$(pci_path "$function")/resource" ]]; then
            printf '  resource:\n' >&2
            sed 's/^/    /' "$(pci_path "$function")/resource" >&2 2>/dev/null || true
        fi

        if command -v "$LSPCI_BIN" >/dev/null 2>&1; then
            printf '  lspci -vvnnk:\n' >&2
            "$LSPCI_BIN" -vvnnk -s "$function" 2>&1 | sed 's/^/    /' >&2 || true
        fi
    done
}

print_vfio_state() {
    local bdf=$1 group member class driver override relation vfio_path
    local -a members=()
    group=$(pci_iommu_group "$bdf")
    vfio_path="$SYSFS_ROOT/bus/pci/drivers/vfio-pci"
    iommu_group_members members "$bdf"

    printf '%s\n' '--- VFIO host state ---' >&2
    if [[ -d "$vfio_path" ]]; then
        printf 'vfio-pci driver: present (%s)\n' "$vfio_path" >&2
    else
        printf 'vfio-pci driver: MISSING (%s)\n' "$vfio_path" >&2
    fi

    printf 'IOMMU group: %s' "$group" >&2
    if [[ "$group" != "-" ]]; then
        if [[ -e "$DEV_ROOT/vfio/$group" ]]; then
            printf ' / VFIO node: %s/vfio/%s\n' "$DEV_ROOT" "$group" >&2
        else
            printf ' / VFIO node: absent\n' >&2
        fi
    else
        printf '\n' >&2
    fi

    for member in "${members[@]}"; do
        class=$(pci_class "$member")
        driver=$(pci_driver "$member")
        override=$(pci_driver_override "$member")
        if [[ "$member" == "$bdf" ]]; then
            relation='target'
        elif [[ "${member%.*}" == "${bdf%.*}" ]]; then
            relation='same-device-function'
        elif is_bridge_class "$member"; then
            relation='bridge-topology'
        else
            relation='other-endpoint'
        fi
        printf '  %s class=%s driver=%s override=%s role=%s\n' \
            "$member" "$class" "$driver" "$override" "$relation" >&2
    done
}

print_kernel_vfio_log() {
    local bdf=$1 since_epoch=${2:-0} short_bdf pattern output='' filtered=''

    # Tests and alternate sysfs fixtures must never read the real host log.
    if [[ "$SYSFS_ROOT" != "/sys" || "$PROC_ROOT" != "/proc" ]]; then
        return 0
    fi

    short_bdf=${bdf#0000:}
    pattern="${bdf}|${short_bdf}|vfio[-_]pci|vfio|iommu|AMD-Vi|amdgpu|probe.*fail|BAR|resource|vgaarb|aperture"

    if command -v journalctl >/dev/null 2>&1; then
        if (( since_epoch > 0 )); then
            output=$(journalctl -k -b --since "@${since_epoch}" --no-pager -o short-monotonic 2>/dev/null || true)
        else
            output=$(journalctl -k -b -n 1200 --no-pager -o short-monotonic 2>/dev/null || true)
        fi
    fi

    if [[ -z "$output" ]] && command -v dmesg >/dev/null 2>&1; then
        output=$(dmesg --color=never 2>/dev/null | tail -n 1200 || true)
    fi

    filtered=$(printf '%s\n' "$output" | grep -Ei -C 3 "$pattern" | tail -n 220 || true)
    if [[ -n "$filtered" ]]; then
        printf '%s\n' '--- Relevant kernel log ---' >&2
        printf '%s\n' "$filtered" >&2
    else
        warn "関連するカーネルログを取得できませんでした。必要なら sudo journalctl -k -b で確認してください。"
    fi

    if (( since_epoch > 0 )) && [[ -n "$output" ]]; then
        printf '%s\n' '--- Kernel log tail after VFIO operation ---' >&2
        printf '%s\n' "$output" | tail -n 100 >&2
    fi
}

print_project_log_command() {
    local vm=$1
    printf 'incus info --show-log %q' "$vm"
    if [[ -n "$PROJECT" ]]; then
        printf ' --project %q' "$PROJECT"
    fi
}

diagnose_start_failure() {
    local bdf=$1 since_epoch=${2:-0} current_driver group
    warn "VM起動失敗時のGPU/VFIO状態を採取します。"
    print_vfio_state "$bdf"
    print_kernel_vfio_log "$bdf" "$since_epoch"

    current_driver=$(pci_driver "$bdf")
    group=$(pci_iommu_group "$bdf")
    if [[ ! -d "$SYSFS_ROOT/bus/pci/drivers/vfio-pci" ]]; then
        warn "vfio-pciドライバーが登録されていません。'sudo modprobe vfio-pci' とカーネル設定を確認してください。"
    elif [[ "$current_driver" != "vfio-pci" ]]; then
        warn "GPUはvfio-pciへバインドされていません (driver=$current_driver)。上のカーネルログにprobe失敗理由が出ます。"
    fi
    if [[ "$group" != "-" && ! -e "$DEV_ROOT/vfio/$group" ]]; then
        warn "/dev/vfio/$group がありません。vfio-pciへのバインドが成立していない可能性があります。"
    fi
}

preflight_gpu() {
    local bdf=$1 path group group_path member member_bdf class boot driver desc
    local -a related=() foreign=() busy_nodes=()
    path=$(pci_path "$bdf")
    [[ -d "$path" ]] || die "PCIデバイスが消失しました: $bdf"

    desc=$(pci_description "$bdf")
    group=$(pci_iommu_group "$bdf")
    driver=$(pci_driver "$bdf")
    boot=$(pci_boot_vga "$bdf")

    info "GPU: $bdf / $desc"
    info "Host driver: $driver / IOMMU group: $group"

    if [[ "$group" == "-" ]]; then
        die "IOMMUグループがありません。BIOS/UEFIでVT-dまたはAMD-Viを有効化し、必要なら 'sudo ${PROG} prepare-host' 実行後に再起動してください。"
    fi

    if [[ "$boot" == "1" ]]; then
        warn "このGPUはboot VGAです。割り当てるとホストの画面が消えたり、ホストが操作不能になる可能性があります。"
        (( FORCE )) || die "続行する場合だけ --force を付けてください。"
    fi

    shopt -s nullglob
    local drm_entry node
    for drm_entry in "$path"/drm/*; do
        node="$DEV_ROOT/dri/$(basename "$drm_entry")"
        [[ -e "$node" ]] || continue
        if command -v fuser >/dev/null 2>&1 && fuser -s "$node" 2>/dev/null; then
            busy_nodes+=("$node")
        fi
    done
    shopt -u nullglob

    if ((${#busy_nodes[@]} > 0)); then
        warn "ホスト上のプロセスがGPUデバイスを使用しています: ${busy_nodes[*]}"
        (( FORCE )) || die "表示サーバーやGPU処理を停止するか、確認の上 --force を付けてください。"
    fi

    group_path=$(readlink -f "$path/iommu_group")
    if [[ -d "$group_path/devices" ]]; then
        shopt -s nullglob
        for member in "$group_path"/devices/*; do
            member_bdf=$(basename "$member")
            [[ "$member_bdf" == "$bdf" ]] && continue
            if [[ "${member_bdf%.*}" == "${bdf%.*}" ]]; then
                related+=("$member_bdf")
            elif ! is_bridge_class "$member_bdf"; then
                class=$(pci_class "$member_bdf")
                foreign+=("$member_bdf(class=$class,driver=$(pci_driver "$member_bdf"))")
            fi
        done
        shopt -u nullglob
    fi

    if ((${#related[@]} > 0)); then
        info "GPU関連PCI機能（音声/USB等）: ${related[*]}"
    fi

    if ((${#foreign[@]} > 0)); then
        warn "同じIOMMUグループにGPU基板外と思われるPCIエンドポイントがあります: ${foreign[*]}"
        warn "この構成はVFIOグループ制約でVM起動に失敗する可能性が高いです。"
        (( FORCE )) || die "IOMMU分離を見直すか、内容を確認して --force を付けてください。"
    fi
}

check_other_assignments() {
    local vm=$1 bdf=$2 other_vm dev status other_found=0
    while IFS=$'\t' read -r other_vm dev status; do
        [[ -n "$other_vm" ]] || continue
        if [[ "$other_vm" == "$vm" ]]; then
            printf '%s\t%s\t%s\n' "$other_vm" "$dev" "$status"
            continue
        fi
        warn "GPU $bdf は別VMにも設定済みです: VM=$other_vm device=$dev status=$status"
        other_found=1
    done < <(gpu_assignments "$bdf")

    if (( other_found && ! FORCE )); then
        die "同一GPUの重複割当を許可する場合だけ --force を付けてください（同時起動はできません）。"
    fi
}

stop_vm_for_change() {
    local vm=$1 status_lc=${VM_STATUS,,}
    VM_ORIGINALLY_RUNNING=0
    VM_SHOULD_START=0

    if [[ "$status_lc" == "stopped" ]]; then
        (( START_REQUESTED )) && VM_SHOULD_START=1
        return 0
    fi

    if [[ "$status_lc" == "running" ]]; then
        VM_ORIGINALLY_RUNNING=1
    fi

    case "$STOP_MODE" in
        stop)
            ;;
        restart)
            VM_SHOULD_START=1
            ;;
        none)
            die "VM '$vm' は停止していません (status=$VM_STATUS)。--stop または --restart を指定してください。"
            ;;
        *) die "内部エラー: 不正なSTOP_MODE=$STOP_MODE" ;;
    esac

    if (( DRY_RUN )); then
        incus_mutate stop "$vm" --timeout "$STOP_TIMEOUT"
        return 0
    fi

    info "VM '$vm' を停止します。"
    if ! incus_read stop "$vm" --timeout "$STOP_TIMEOUT"; then
        if (( FORCE_STOP )); then
            warn "通常停止に失敗したため強制停止します。"
            incus_read stop "$vm" --force
        else
            die "VMを停止できません。必要なら --force-stop を付けてください。"
        fi
    fi
}

start_vm_after_change() {
    local vm=$1
    (( VM_SHOULD_START || START_REQUESTED )) || return 0
    info "VM '$vm' を起動します。"
    incus_mutate start "$vm"
}

cmd_list() {
    while (($#)); do
        case "$1" in
            -h|--help) usage; return 0 ;;
            *) die "listの不明なオプションです: $1" ;;
        esac
    done
    list_gpus
}

cmd_bind_vfio() {
    local selector="" bdf timeout=$VFIO_BIND_TIMEOUT
    local -a positional=()
    while (($#)); do
        case "$1" in
            --gpu) [[ $# -ge 2 ]] || die "--gpuに値が必要です"; selector=$2; shift 2 ;;
            --timeout|--vfio-timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "$1には秒数が必要です"; timeout=$2; shift 2 ;;
            --force) FORCE=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            -h|--help) usage; return 0 ;;
            -*) die "bind-vfioの不明なオプションです: $1" ;;
            *) positional+=("$1"); shift ;;
        esac
    done
    [[ -n "$selector" ]] || selector=${positional[0]:-}
    ((${#positional[@]} <= 1)) || die "bind-vfioの位置引数が多すぎます。"
    [[ -n "$selector" ]] || die "bind-vfioにはGPU指定が必要です。"

    bdf=$(resolve_gpu "$selector")
    preflight_gpu "$bdf"
    prebind_vfio_functions "$bdf" "$timeout" || \
        die "GPUをvfio-pciへ事前バインドできませんでした。上のカーネルログを確認してください。"
    ok "VFIO事前バインドが完了しました: pci=$bdf"
    warn "ホストへ戻す場合は 'sudo ${PROG} release-vfio $bdf' を実行してください。"
}

cmd_inspect() {
    local vm="" selector="" bdf="" existing_line=""
    local timeout=$VFIO_BIND_TIMEOUT rc=0 bind_ok=0 restore_ok=1 vm_restore_ok=1
    local original_status="" final_status="unknown"
    local -a positional=()

    while (($#)); do
        case "$1" in
            --vm) [[ $# -ge 2 ]] || die "--vmに値が必要です"; vm=$2; shift 2 ;;
            --gpu) [[ $# -ge 2 ]] || die "--gpuに値が必要です"; selector=$2; shift 2 ;;
            --project) [[ $# -ge 2 ]] || die "--projectに値が必要です"; PROJECT=$2; shift 2 ;;
            --timeout|--vfio-timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "$1には秒数が必要です"; timeout=$2; shift 2 ;;
            --stop-timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--stop-timeoutには秒数が必要です"; STOP_TIMEOUT=$2; shift 2 ;;
            --force-stop) FORCE_STOP=1; shift ;;
            --force) FORCE=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            -h|--help) usage; return 0 ;;
            -*) die "inspectの不明なオプションです: $1" ;;
            *) positional+=("$1"); shift ;;
        esac
    done

    [[ -n "$vm" ]] || vm=${positional[0]:-}
    [[ -n "$selector" ]] || selector=${positional[1]:-}
    ((${#positional[@]} <= 2)) || die "inspectの位置引数が多すぎます。"
    [[ -n "$vm" && -n "$selector" ]] || die "inspectにはVM名とGPU指定が必要です。"

    bdf=$(resolve_gpu "$selector")
    load_instances
    load_vm "$vm"
    check_cluster_location "$vm"
    existing_line=$(check_other_assignments "$vm" "$bdf")
    original_status=$VM_STATUS

    printf '=== incus-gpu inspect %s ===\n' "$VERSION"
    printf 'VM=%s project=%s original_status=%s\n' "$vm" "${PROJECT:-default}" "$original_status"
    printf 'GPU=%s timeout=%ss\n' "$bdf" "$timeout"
    [[ -n "$existing_line" ]] && printf 'Existing assignment: %s\n' "$existing_line"

    preflight_gpu "$bdf"
    printf '\n--- baseline ---\n'
    print_vfio_state "$bdf"
    print_pci_diagnostics "$bdf"

    # inspectは一発で精査するため、稼働中VMは自動停止し、精査後に元へ戻す。
    STOP_MODE="restart"
    stop_vm_for_change "$vm"

    printf '\n--- guarded VFIO probe ---\n'
    if prebind_vfio_functions "$bdf" "$timeout"; then
        bind_ok=1
        ok "GPU関連機能のvfio-pciバインド試験に成功しました。"
        if restore_prebound_vfio; then
            ok "PCI状態を精査前へ復元しました。"
        else
            rc=$?
            restore_ok=0
        fi
    else
        rc=$?
    fi

    if [[ -n "$SYSFS_WRITE_STUCK_PID" ]]; then
        printf '\n=== inspection summary ===\n'
        printf 'result=KERNEL_WAIT\n'
        printf 'vm=%s original_status=%s final_status=Stopped\n' "$vm" "$original_status"
        printf 'gpu=%s\n' "$bdf"
        printf 'blocked_operation=%s\n' "$SYSFS_WRITE_STUCK_LABEL"
        printf 'worker_pid=%s state=%s wchan=%s\n' \
            "$SYSFS_WRITE_STUCK_PID" "$SYSFS_WRITE_STUCK_STATE" "$SYSFS_WRITE_STUCK_WCHAN"
        printf 'action=host-reboot-required-if-state-D\n'
        return 124
    fi

    if (( VM_ORIGINALLY_RUNNING )); then
        info "精査完了後、VM '$vm' を元の稼働状態へ戻します。"
        if incus_mutate start "$vm"; then
            :
        else
            vm_restore_ok=0
            (( rc == 0 )) && rc=1
            warn "VM '$vm' を再起動できませんでした。"
        fi
    fi

    if (( ! DRY_RUN )); then
        load_instances
        load_vm "$vm"
        final_status=$VM_STATUS
    else
        final_status="dry-run"
    fi

    printf '\n--- final host state ---\n'
    print_vfio_state "$bdf"
    printf '\n=== inspection summary ===\n'
    if (( bind_ok && restore_ok && vm_restore_ok && rc == 0 )); then
        printf 'result=PASS\n'
    else
        printf 'result=FAIL\n'
    fi
    printf 'vm=%s original_status=%s final_status=%s\n' "$vm" "$original_status" "$final_status"
    printf 'gpu=%s bind_ok=%s restore_ok=%s vm_restore_ok=%s exit=%s\n' \
        "$bdf" "$bind_ok" "$restore_ok" "$vm_restore_ok" "$rc"

    return "$rc"
}

